<odoo>
    <data>
        <record id="view_stock_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[last()]" position="after">
                    <button name="send_order_to_ongoing" type="object" string="Sync to Ongoing" class="oe_highlight" invisible="picking_type_code != 'outgoing'"/>
                    <button name="ongoing_incoming_shipment" type="object" string="Push to Ongoing" class="oe_highlight" invisible="picking_type_code != 'incoming'"/>
                </xpath>
                <field name="origin" position="after">
                    <field name="ongoing_order_id"/>
                    <field name="ongoing_order_status"/>
                </field>
            </field>
        </record>
    </data>
</odoo>